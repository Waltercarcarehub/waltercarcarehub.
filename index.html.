        // --- WALTER WORKSHOP CMS PORTAL ENGINE ---
        function openAdminModal() { document.getElementById("adminModal")?.classList.remove("hidden"); }
        function closeAdminModal() { document.getElementById("adminModal")?.classList.add("hidden"); }

        function handleAdminLogin(e) {
            e.preventDefault();
            const u = document.getElementById("adminUser").value;
            const p = document.getElementById("adminPass").value;

            if (u === "admin" && p === "walter123") {
                document.getElementById("adminLoginView").classList.add("hidden");
                document.getElementById("cmsCloseLoginBtn").classList.add("hidden");
                document.getElementById("adminDashboardView").classList.remove("hidden");
                document.getElementById("cmsHeaderControls").classList.remove("hidden");
                switchCmsTab('galleryManager');
            } else {
                alert("Invalid Credentials. Default access: admin / walter123");
            }
        }

        function logoutAdmin() {
            document.getElementById("adminDashboardView").classList.add("hidden");
            document.getElementById("cmsHeaderControls").classList.add("hidden");
            document.getElementById("cmsCloseLoginBtn").classList.remove("hidden");
            document.getElementById("adminLoginView").classList.remove("hidden");
        }

        function switchCmsTab(tabName) {
            document.querySelectorAll(".cms-tab-content").forEach(t => t.classList.add("hidden"));
            document.querySelectorAll(".cms-nav-btn").forEach(b => {
                b.classList.remove("bg-brand-red", "text-white");
                b.classList.add("bg-brand-card", "text-gray-300");
            });

            document.getElementById(`cmsTab-${tabName}`)?.classList.remove("hidden");
            const btn = document.getElementById(`cmsNav-${tabName}`);
            if (btn) {
                btn.classList.remove("bg-brand-card", "text-gray-300");
                btn.classList.add("bg-brand-red", "text-white");
            }

            if (tabName === 'galleryManager') renderCmsGalleryTable();
            if (tabName === 'bookings') renderCmsLeadsTable();
            if (tabName === 'jobApplications') renderCmsJobAppsTable();
            if (tabName === 'jobCards') renderCmsJobCardsTable();
            if (tabName === 'ledger') renderCmsLedgerTable();
            if (tabName === 'siteSettings') loadCmsSiteSettings();
        }

        // --- GALLERY MANAGER LOGIC (ADD / EDIT / DELETE) ---
        function handleLocalImageUpload(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    document.getElementById("cmsImgSource").value = evt.target.result;
                };
                reader.readAsDataURL(file);
            }
        }

        function renderCmsGalleryTable() {
            const tbody = document.getElementById("cmsGalleryTableBody");
            if (!tbody) return;

            const gallery = getGalleryData();
            if (gallery.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-gray-500">No photos in gallery. Add one using the form above.</td></tr>`;
                return;
            }

            tbody.innerHTML = gallery.map((item, idx) => `
                <tr class="hover:bg-brand-dark/50">
                    <td class="p-3">
                        <img src="${item.img}" class="w-12 h-12 object-cover rounded border border-gray-800" onerror="this.src='https://placehold.co/100x100'">
                    </td>
                    <td class="p-3">
                        <p class="font-bold text-white">${item.title}</p>
                        <p class="text-[10px] text-gray-400 line-clamp-1">${item.desc}</p>
                    </td>
                    <td class="p-3">
                        <span class="px-2 py-1 bg-brand-card border border-gray-800 rounded text-[10px] text-brand-red font-semibold uppercase">${item.category}</span>
                    </td>
                    <td class="p-3 text-right">
                        <div class="flex items-center justify-end gap-2">
                            <button onclick="startEditGalleryPhoto(${idx})" class="px-2.5 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded text-[11px] font-semibold flex items-center gap-1">
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </button>
                            <button onclick="deleteGalleryPhoto(${idx})" class="px-2.5 py-1 bg-red-600 hover:bg-red-700 text-white rounded text-[11px] font-semibold flex items-center gap-1">
                                <i class="fa-solid fa-trash"></i> Delete
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        function startEditGalleryPhoto(idx) {
            const gallery = getGalleryData();
            const item = gallery[idx];
            if (!item) return;

            currentEditIndex = idx;
            document.getElementById("cmsImgSource").value = item.img;
            document.getElementById("cmsImgTitle").value = item.title;
            document.getElementById("cmsImgCategory").value = item.category;
            document.getElementById("cmsImgDesc").value = item.desc;

            document.getElementById("btnSavePhoto").textContent = "Update Photo";
            document.getElementById("formSubTitle").textContent = `Editing Showcase Photo: ${item.title}`;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetGalleryForm() {
            currentEditIndex = -1;
            document.getElementById("cmsImgSource").value = "";
            document.getElementById("cmsImgTitle").value = "";
            document.getElementById("cmsImgCategory").value = "Panel Beating & Prep";
            document.getElementById("cmsImgDesc").value = "";

            document.getElementById("btnSavePhoto").textContent = "Add Showcase Photo";
            document.getElementById("formSubTitle").textContent = "Edit Showcase Photo / Add Showcase Photo";
        }

        function saveGalleryPhoto() {
            const img = document.getElementById("cmsImgSource").value;
            const title = document.getElementById("cmsImgTitle").value;
            const category = document.getElementById("cmsImgCategory").value;
            const desc = document.getElementById("cmsImgDesc").value;

            if (!img || !title) {
                alert("Please provide vehicle/project title and select an image file or paste URL.");
                return;
            }

            let gallery = getGalleryData();

            if (currentEditIndex >= 0) {
                // Update Existing Photo
                gallery[currentEditIndex] = { id: gallery[currentEditIndex].id, title, category, img, desc };
                alert("Showcase photo updated successfully!");
            } else {
                // Add New Photo
                gallery.unshift({ id: Date.now(), title, category, img, desc });
                alert("New showcase photo added to your website gallery!");
            }

            localStorage.setItem("walter_gallery", JSON.stringify(gallery));
            initGallery();
            renderCmsGalleryTable();
            resetGalleryForm();
        }

        function deleteGalleryPhoto(idx) {
            if (!confirm("Are you sure you want to delete this photo from the showcase?")) return;
            let gallery = getGalleryData();
            gallery.splice(idx, 1);
            localStorage.setItem("walter_gallery", JSON.stringify(gallery));
            initGallery();
            renderCmsGalleryTable();
            if (currentEditIndex === idx) resetGalleryForm();
        }

        // --- BOOKINGS & LEADS LOGIC ---
        function renderCmsLeadsTable() {
            const tbody = document.getElementById("cmsLeadsTableBody");
            if (!tbody) return;

            const leads = JSON.parse(localStorage.getItem("walter_leads") || "[]");
            if (leads.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-4 text-center text-gray-500">No client booking leads logged yet.</td></tr>`;
                return;
            }

            tbody.innerHTML = leads.map((l, idx) => `
                <tr>
                    <td class="p-3 text-gray-400">${l.date}</td>
                    <td class="p-3 font-semibold text-white">${l.name}</td>
                    <td class="p-3 text-brand-red"><a href="tel:${l.phone}">${l.phone}</a></td>
                    <td class="p-3 font-bold">${l.car}</td>
                    <td class="p-3"><span class="px-2 py-0.5 bg-gray-800 rounded text-[10px]">${l.service}</span></td>
                    <td class="p-3 text-gray-400">${l.notes || 'N/A'}</td>
                    <td class="p-3 text-right">
                        <button onclick="deleteCmsLead(${idx})" class="text-red-500 hover:text-red-400 p-1"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `).join('');
        }

        function deleteCmsLead(idx) {
            if (!confirm("Delete lead record?")) return;
            let leads = JSON.parse(localStorage.getItem("walter_leads") || "[]");
            leads.splice(idx, 1);
            localStorage.setItem("walter_leads", JSON.stringify(leads));
            renderCmsLeadsTable();
        }

        // --- JOB APPLICATIONS LOGIC ---
        function renderCmsJobAppsTable() {
            const tbody = document.getElementById("cmsJobAppsTableBody");
            const countLabel = document.getElementById("statJobAppsCount");
            if (!tbody) return;

            const apps = JSON.parse(localStorage.getItem("walter_job_apps") || "[]");
            if (countLabel) countLabel.textContent = `${apps.length} Total Applications`;

            if (apps.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="p-4 text-center text-gray-500">No job applications submitted yet.</td></tr>`;
                return;
            }

            tbody.innerHTML = apps.map((a, idx) => `
                <tr class="hover:bg-brand-dark/50">
                    <td class="p-3 text-gray-400">${a.date}</td>
                    <td class="p-3 font-semibold text-white">${a.name}</td>
                    <td class="p-3 text-brand-red"><a href="tel:${a.phone}">${a.phone}</a></td>
                    <td class="p-3 font-bold text-yellow-400">${a.position}</td>
                    <td class="p-3">${a.exp}</td>
                    <td class="p-3 font-mono text-[11px]">
                        ${a.cvUrl !== 'N/A' ? `<a href="${a.cvUrl}" target="_blank" class="text-blue-400 underline flex items-center gap-1"><i class="fa-solid fa-file-pdf"></i> View Resume</a>` : 'No CV link'}
                    </td>
                    <td class="p-3">
                        <select onchange="updateAppStatus(${idx}, this.value)" class="bg-brand-card border border-gray-800 rounded px-2 py-1 text-[10px] text-white">
                            <option value="Pending" ${a.status === 'Pending' ? 'selected' : ''}>Pending</option>
                            <option value="Interviewed" ${a.status === 'Interviewed' ? 'selected' : ''}>Interviewed</option>
                            <option value="Hired" ${a.status === 'Hired' ? 'selected' : ''}>Hired</option>
                            <option value="Rejected" ${a.status === 'Rejected' ? 'selected' : ''}>Rejected</option>
                        </select>
                    </td>
                    <td class="p-3 text-right">
                        <button onclick="deleteCmsJobApp(${idx})" class="text-red-500 hover:text-red-400 p-1"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `).join('');
        }

        function updateAppStatus(idx, status) {
            let apps = JSON.parse(localStorage.getItem("walter_job_apps") || "[]");
            apps[idx].status = status;
            localStorage.setItem("walter_job_apps", JSON.stringify(apps));
        }

        function deleteCmsJobApp(idx) {
            if (!confirm("Delete candidate application record?")) return;
            let apps = JSON.parse(localStorage.getItem("walter_job_apps") || "[]");
            apps.splice(idx, 1);
            localStorage.setItem("walter_job_apps", JSON.stringify(apps));
            renderCmsJobAppsTable();
        }

        // --- WORKSHOP JOB CARDS LOGIC ---
        function renderCmsJobCardsTable() {
            const tbody = document.getElementById("cmsJobCardsTableBody");
            if (!tbody) return;

            const cards = JSON.parse(localStorage.getItem("walter_job_cards") || "[]");
            if (cards.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-4 text-center text-gray-500">No active repair job cards found.</td></tr>`;
                return;
            }

            tbody.innerHTML = cards.map((c, idx) => `
                <tr>
                    <td class="p-3 font-mono text-brand-red font-bold">${c.id}</td>
                    <td class="p-3 font-semibold text-white">${c.reg}</td>
                    <td class="p-3">${c.owner}</td>
                    <td class="p-3">${c.service}</td>
                    <td class="p-3 text-yellow-400">${c.tech || 'Unassigned'}</td>
                    <td class="p-3"><span class="px-2 py-0.5 bg-brand-card border border-brand-red/40 text-brand-red rounded text-[10px] font-bold uppercase">${c.stage}</span></td>
                    <td class="p-3 text-right">
                        <button onclick="deleteCmsJobCard(${idx})" class="text-red-500 hover:text-red-400 p-1"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `).join('');
        }

        function openAddJobCardModal() { document.getElementById("addJobCardModal")?.classList.remove("hidden"); }
        function closeAddJobCardModal() { document.getElementById("addJobCardModal")?.classList.add("hidden"); }

        function handleSaveJobCard(e) {
            e.preventDefault();
            const reg = document.getElementById("cardReg").value;
            const owner = document.getElementById("cardOwner").value;
            const service = document.getElementById("cardService").value;
            const tech = document.getElementById("cardTech").value;
            const stage = document.getElementById("cardStage").value;

            let cards = JSON.parse(localStorage.getItem("walter_job_cards") || "[]");
            cards.unshift({
                id: "JOB-" + (100 + cards.length + 1),
                reg, owner, service, tech, stage
            });

            localStorage.setItem("walter_job_cards", JSON.stringify(cards));
            closeAddJobCardModal();
            renderCmsJobCardsTable();
            e.target.reset();
        }

        function deleteCmsJobCard(idx) {
            if (!confirm("Delete workshop job card?")) return;
            let cards = JSON.parse(localStorage.getItem("walter_job_cards") || "[]");
            cards.splice(idx, 1);
            localStorage.setItem("walter_job_cards", JSON.stringify(cards));
            renderCmsJobCardsTable();
        }

        // --- INCOME & EXPENSES LEDGER LOGIC ---
        function renderCmsLedgerTable() {
            const tbody = document.getElementById("cmsLedgerTableBody");
            if (!tbody) return;

            const ledger = JSON.parse(localStorage.getItem("walter_ledger") || "[]");

            let totalIncome = 0;
            let totalExpense = 0;

            ledger.forEach(item => {
                if (item.type === 'Income') totalIncome += Number(item.amount || 0);
                if (item.type === 'Expense') totalExpense += Number(item.amount || 0);
            });

            document.getElementById("statLedgerIncome").textContent = "Ksh " + totalIncome.toLocaleString();
            document.getElementById("statLedgerExpenses").textContent = "Ksh " + totalExpense.toLocaleString();
            document.getElementById("statLedgerNet").textContent = "Ksh " + (totalIncome - totalExpense).toLocaleString();

            if (ledger.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-gray-500">No income or expense entries logged.</td></tr>`;
                return;
            }

            tbody.innerHTML = ledger.map((item, idx) => `
                <tr>
                    <td class="p-3 text-gray-400">${item.date}</td>
                    <td class="p-3 font-bold uppercase text-[10px] ${item.type === 'Income' ? 'text-green-400' : 'text-red-400'}">${item.type}</td>
                    <td class="p-3 font-semibold text-white">${item.desc}</td>
                    <td class="p-3 text-gray-400">${item.category || 'General'}</td>
                    <td class="p-3 font-bold ${item.type === 'Income' ? 'text-green-400' : 'text-red-400'}">Ksh ${Number(item.amount).toLocaleString()}</td>
                    <td class="p-3 text-right">
                        <button onclick="deleteCmsLedger(${idx})" class="text-red-500 hover:text-red-400 p-1"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `).join('');
        }

        function openAddLedgerModal() { document.getElementById("addLedgerModal")?.classList.remove("hidden"); }
        function closeAddLedgerModal() { document.getElementById("addLedgerModal")?.classList.add("hidden"); }

        function handleSaveLedger(e) {
            e.preventDefault();
            const type = document.getElementById("ledgerType").value;
            const desc = document.getElementById("ledgerDesc").value;
            const category = document.getElementById("ledgerCategory").value;
            const amount = document.getElementById("ledgerAmount").value;

            let ledger = JSON.parse(localStorage.getItem("walter_ledger") || "[]");
            ledger.unshift({
                id: Date.now(),
                date: new Date().toISOString().split('T')[0],
                type, desc, category, amount
            });

            localStorage.setItem("walter_ledger", JSON.stringify(ledger));
            closeAddLedgerModal();
            renderCmsLedgerTable();
            e.target.reset();
        }

        function deleteCmsLedger(idx) {
            if (!confirm("Delete ledger transaction?")) return;
            let ledger = JSON.parse(localStorage.getItem("walter_ledger") || "[]");
            ledger.splice(idx, 1);
            localStorage.setItem("walter_ledger", JSON.stringify(ledger));
            renderCmsLedgerTable();
        }

        // --- SITE SETTINGS & LOGO ---
        function loadCmsSiteSettings() {
            const settings = JSON.parse(localStorage.getItem("walter_settings") || "{}");
            if (document.getElementById("cmsEditLogoUrl")) document.getElementById("cmsEditLogoUrl").value = settings.logoUrl || DEFAULT_LOGO;
            if (document.getElementById("cmsEditPhone1")) document.getElementById("cmsEditPhone1").value = settings.phone1 || "+254 742 412 994";
            if (document.getElementById("cmsEditPhone2")) document.getElementById("cmsEditPhone2").value = settings.phone2 || "+254 780 047 034";
            if (document.getElementById("cmsEditLocation")) document.getElementById("cmsEditLocation").value = settings.location || "Karen, Nairobi, Kenya";
            if (document.getElementById("cmsEditHours")) document.getElementById("cmsEditHours").value = settings.hours || "Mon - Sat: 8:00 AM - 6:00 PM";
        }

        function saveCmsLogo() {
            const logoUrl = document.getElementById("cmsEditLogoUrl").value;
            let settings = JSON.parse(localStorage.getItem("walter_settings") || "{}");
            settings.logoUrl = logoUrl;
            localStorage.setItem("walter_settings", JSON.stringify(settings));

            applyLogoToDom(logoUrl);
            alert("Branding logo updated across header, hero section, and footer!");
        }

        function saveCmsSettings() {
            let settings = JSON.parse(localStorage.getItem("walter_settings") || "{}");
            settings.phone1 = document.getElementById("cmsEditPhone1").value;
            settings.phone2 = document.getElementById("cmsEditPhone2").value;
            settings.location = document.getElementById("cmsEditLocation").value;
            settings.hours = document.getElementById("cmsEditHours").value;
            localStorage.setItem("walter_settings", JSON.stringify(settings));

            loadSiteSettings();
            alert("Contact details and hours updated!");
        }

        function applyLogoToDom(url) {
            ["headerLogo", "heroLogo", "footerLogo"].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.src = url;
            });
        }

        function loadSiteSettings() {
            const settings = JSON.parse(localStorage.getItem("walter_settings") || "{}");
            applyLogoToDom(settings.logoUrl || DEFAULT_LOGO);
            if (document.getElementById("topbarHours")) document.getElementById("topbarHours").innerHTML = `<i class="fa-regular fa-clock mr-1.5"></i> ${settings.hours || "Mon - Sat: 8:00 AM - 6:00 PM"}`;
            if (document.getElementById("topbarPhone")) document.getElementById("topbarPhone").innerHTML = `<i class="fa-solid fa-phone text-xs"></i> ${settings.phone1 || "+254 742 412 994"}`;
            if (document.getElementById("contactLocation")) document.getElementById("contactLocation").textContent = settings.location || "Karen, Nairobi, Kenya";
        }
    </script>
</body>
</html>
