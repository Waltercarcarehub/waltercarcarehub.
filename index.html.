    <script>
        const DEFAULT_LOGO = "WhatsApp Image 2026-09-22 at 10.05.32_3.jpeg";
        let currentEditIndex = -1; // -1 means adding new photo

        const defaultGallery = [
            { id: 1, title: "Mazda Rear Panel Repair & Sanding", category: "Panel Beating & Prep", img: "WhatsApp Image 2026-09-22 at 10.05.20_2.jpeg", desc: "Rear panel alignment, dent smoothing, and high-build primer coat." },
            { id: 2, title: "Prado Matte Black Bodykit Fitting", category: "Panel Beating & Prep", img: "WhatsApp Image 2026-09-22 at 10.05.19 (1)_2.jpeg", desc: "Front fascia assembly with custom matrix LED lights and stealth mesh grill." },
            { id: 3, title: "Enclosed Spray Booth Painting", category: "Spray Booth & Painting", img: "WhatsApp Image 2026-09-22 at 10.05.19_2.jpeg", desc: "Deep piano black baked oven finish with multi-layer high gloss clear coat." },
            { id: 4, title: "Lexus Style Facelift Conversion", category: "Facelifts & Restorations", img: "WhatsApp Image 2026-09-22 at 10.05.18 (1)_2.jpeg", desc: "Completed body transformation with pristine shine and showroom polish." },
            { id: 5, title: "Toyota Prado Finished Gloss Black", category: "Gloss Finish & Ceramic", img: "WhatsApp Image 2026-09-22 at 10.05.18_2.jpeg", desc: "Modern front body kit alignment with integrated daytime running lights." }
        ];

        document.addEventListener("DOMContentLoaded", function() {
            initDatabases();
            initGallery();
            loadSiteSettings();
        });

        function initDatabases() {
            if (!localStorage.getItem("walter_gallery")) {
                localStorage.setItem("walter_gallery", JSON.stringify(defaultGallery));
            }
            if (!localStorage.getItem("walter_job_apps")) {
                const sampleApps = [
                    { id: 1, name: "Josphine Achungo", phone: "+254 712 999 000", position: "Detailer & Ceramic Polish", exp: "4 Years", cvUrl: "https://drive.google.com/sample_cv", notes: "Experienced in multi-stage paint correction and ceramic coatings.", status: "Pending", date: "2026-09-22" }
                ];
                localStorage.setItem("walter_job_apps", JSON.stringify(sampleApps));
            }
            if (!localStorage.getItem("walter_job_cards")) {
                const sampleCards = [
                    { id: "JOB-101", reg: "KDA 888A - Prado TX", owner: "David Mutua", service: "Facelift Kit & Full Paint", tech: "Master Walter", stage: "In Spray Booth" }
                ];
                localStorage.setItem("walter_job_cards", JSON.stringify(sampleCards));
            }
            if (!localStorage.getItem("walter_ledger")) {
                const sampleLedger = [
                    { id: 1, date: "2026-09-20", type: "Income", desc: "Toyota Prado Full Oven Painting", category: "Bodywork", amount: 85000 },
                    { id: 2, date: "2026-09-21", type: "Expense", desc: "Purchased 2K Paint Clear Coat & Hardener", category: "Materials", amount: 18000 }
                ];
                localStorage.setItem("walter_ledger", JSON.stringify(sampleLedger));
            }
            if (!localStorage.getItem("walter_leads")) {
                const sampleLeads = [
                    { id: 1, name: "Peter Kamau", phone: "+254 700 123 456", car: "Prado TX 2017", service: "Car Facelift", notes: "Inquiring about facelift package", date: "2026-09-20" }
                ];
                localStorage.setItem("walter_leads", JSON.stringify(sampleLeads));
            }
        }

        function getGalleryData() {
            const stored = localStorage.getItem("walter_gallery");
            if (stored) {
                try { return JSON.parse(stored); } catch(e) { return defaultGallery; }
            }
            return defaultGallery;
        }

        function initGallery() {
            const items = getGalleryData();
            renderGallery(items);
        }

        function renderGallery(items) {
            const container = document.getElementById("galleryContainer");
            if (!container) return;

            container.innerHTML = "";
            items.forEach(item => {
                const card = document.createElement("div");
                card.className = "glass-card rounded-2xl overflow-hidden group cursor-pointer border border-gray-800 hover:border-brand-red/50 transition-all duration-300";
                card.onclick = function() { openLightbox(item.img, item.title + " - " + item.desc); };

                card.innerHTML = `
                    <div class="relative h-64 overflow-hidden bg-brand-dark">
                        <img src="${item.img}" 
                             onerror="this.onerror=null; this.src='https://placehold.co/600x400/161B22/E50914?text=Walter+Car+Care';"
                             class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" 
                             alt="${item.title}">
                        <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-transparent to-transparent opacity-80"></div>
                        <span class="absolute top-3 left-3 px-3 py-1 bg-brand-red/80 backdrop-blur-sm text-white text-[10px] font-bold uppercase rounded-md tracking-wider">
                            ${item.category}
                        </span>
                    </div>
                    <div class="p-5">
                        <h4 class="font-heading text-lg font-bold text-white uppercase group-hover:text-brand-red transition-colors">${item.title}</h4>
                        <p class="text-gray-400 text-xs mt-1.5 line-clamp-2 leading-relaxed">${item.desc}</p>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function filterGallery(cat) {
            const buttons = document.querySelectorAll("#galleryFilters .filter-btn");
            buttons.forEach(btn => {
                btn.className = "filter-btn px-4 py-2 rounded-lg bg-brand-card hover:bg-gray-800 text-gray-300 text-xs font-semibold tracking-wider uppercase transition-all border border-gray-800";
            });

            if (event && event.currentTarget) {
                event.currentTarget.className = "filter-btn active px-4 py-2 rounded-lg bg-brand-red text-white text-xs font-semibold tracking-wider uppercase transition-all";
            }

            const allItems = getGalleryData();
            if (cat === 'all') {
                renderGallery(allItems);
            } else {
                renderGallery(allItems.filter(item => item.category === cat));
            }
        }

        // Job Application Form Submission Handler
        function handleJobApplicationSubmit(e) {
            e.preventDefault();
            const name = document.getElementById("appFullName").value;
            const phone = document.getElementById("appPhone").value;
            const position = document.getElementById("appPosition").value;
            const exp = document.getElementById("appExp").value + " Years";
            const cvUrl = document.getElementById("appCvUrl").value || "N/A";
            const notes = document.getElementById("appNotes").value;

            let apps = JSON.parse(localStorage.getItem("walter_job_apps") || "[]");
            apps.unshift({
                id: Date.now(),
                name,
                phone,
                position,
                exp,
                cvUrl,
                notes,
                status: "Pending",
                date: new Date().toISOString().split('T')[0]
            });

            localStorage.setItem("walter_job_apps", JSON.stringify(apps));
            alert("Thank you, " + name + "! Your job application has been submitted directly to the Walter Car Care Hub Portal.");
            e.target.reset();
        }

